# Gmail SMTP (local watcher / personal notification)
SMTP_USER=your_account@gmail.com
SMTP_APP_PASSWORD=your_google_app_password
MAIL_TO=your_account@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Default theaters
THEATERS=영등포타임스퀘어:0059,용산아이파크몰:0013

# Legacy/personal watcher target example
DATE_FROM=2026-08-25
DATE_TO=2026-09-07
MOVIE_KEYWORD=오디세이

# Local polling settings
INTERVAL_SECONDS=150
REQUEST_TIMEOUT_SECONDS=20
USE_COLOR=true

# Note:
# Dashboard multi-target definitions (IMAX / SCREENX etc.) are currently
# managed in run_multi_special.py TARGETS.
